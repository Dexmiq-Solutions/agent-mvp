# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="Agent MVP"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# ==============================================================================
# Future Integrations (Optional in Phase 1 - Not required to start the app)
# ==============================================================================

# Supabase (PostgreSQL & Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="documents"
# Supabase PostgreSQL connection string (supports postgresql:// or postgresql+asyncpg://)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Qdrant Vector Store
QDRANT_URL=
QDRANT_API_KEY=

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
EMBEDDING_MODEL="voyage-3-large"

# LLM Provider
OPENAI_API_KEY=
LLM_MODEL="gpt-4o"
