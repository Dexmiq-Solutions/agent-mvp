# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="Agent MVP"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# ==============================================================================

# Supabase (PostgreSQL & Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="documents"
# Supabase PostgreSQL connection string (supports postgresql:// or postgresql+asyncpg://)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Qdrant Vector Store & Indexing
QDRANT_URL="https://[YOUR-CLUSTER-ID].qdrant.tech"
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME="document_chunks"
QDRANT_TIMEOUT=30
QDRANT_VECTOR_SIZE=1024
QDRANT_BATCH_SIZE=64
QDRANT_DISTANCE="Cosine"
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_DELAY=0.5
QDRANT_RETRY_BACKOFF=2.0

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
EMBEDDING_MODEL="voyage-4"

# Redis Cache (Shared embedding result cache)
REDIS_URL="redis://localhost:6379/0"

# LLM Provider & Generation Stage
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL="gpt-4o"
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=0.5
LLM_RETRY_BACKOFF=2.0
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=
LLM_TOP_P=
LLM_STREAMING_ENABLED=false

# Agent Runtime & OpenRouter Configuration (Phase 2)
AGENT_MODEL="liquid/lfm-2.5-2.6b:free"
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=
AGENT_TIMEOUT=60.0
AGENT_MAX_RETRIES=2

# Contextual Enrichment (Document-level enrichment before embeddings)
CONTEXTUAL_ENRICHMENT_ENABLED=false
CONTEXTUAL_ENRICHMENT_STRATEGY="structured"

# Retrieval & Query Preprocessing / Transformation
MAX_QUERY_LENGTH=2000
QUERY_TRANSFORMATION_ENABLED=true
QUERY_TRANSFORMATION_STRATEGY="llm_rewrite"
QUERY_TRANSFORMATION_MODEL="gpt-4o"
QUERY_TRANSFORMATION_TIMEOUT=5.0
QUERY_TRANSFORMATION_MAX_RETRIES=1
QUERY_TRANSFORMATION_MAX_FALLBACK_ATTEMPTS=1
QUERY_TRANSFORMATION_BASE_URL=
VECTOR_SEARCH_TOP_K=10
VECTOR_SEARCH_SCORE_THRESHOLD=
SPARSE_INDEXING_ENABLED=true
SPARSE_ENCODER_STRATEGY="technical_hash"
SPARSE_ENCODER_VERSION="1.0"
SPARSE_VECTOR_NAME="sparse"
KEYWORD_SEARCH_TOP_K=10
KEYWORD_SEARCH_SCORE_THRESHOLD=
FUSION_RRF_K=60
FUSION_TOP_K=10
METADATA_FILTERING_ENABLED=true
METADATA_FILTERING_STRICT_MODE=false

