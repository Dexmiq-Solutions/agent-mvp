# Dexmiq Frontend — Environment Variables
# Copy this file to .env or .env.local and fill in your values.

# Backend API URL (leave empty to use the Vite dev proxy at /api → localhost:8000 for local dev)
# For production (e.g., on Render), set this to the deployed backend URL without a trailing slash.
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://localhost:8000
