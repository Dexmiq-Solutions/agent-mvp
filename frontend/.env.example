# Dexmiq Frontend — Environment Variables
# Copy this file to .env or .env.local and fill in your values.

# Backend API base URL
# Local development: http://localhost:8000
# Production on Render: https://<your-backend-service>.onrender.com
VITE_API_URL=http://localhost:8000

# Note: VITE_API_BASE_URL is also supported as an alias for backward compatibility:
# VITE_API_BASE_URL=http://localhost:8000
